# ============================================================
# Copy this file to secret-env.yaml and fill in real values
# DO NOT commit secret-env.yaml to git (it's in .gitignore)
# ============================================================
apiVersion: v1
kind: Secret
metadata:
  name: yelp-lab2-secrets
  namespace: yelp-lab2
type: Opaque
stringData:
  SECRET_KEY: "<your-jwt-signing-secret>"
  GROQ_API_KEY: "<your-groq-api-key>"
  TAVILY_API_KEY: "<your-tavily-api-key>"
  YELP_API_KEY: "<your-yelp-fusion-api-key>"
