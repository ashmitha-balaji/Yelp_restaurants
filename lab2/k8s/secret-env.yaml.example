# ============================================================
# Copy this file to secret-env.yaml and fill in real values
# DO NOT commit secret-env.yaml to git (it's in .gitignore)
# ============================================================
apiVersion: v1
kind: Secret
metadata:
  name: yelp-lab2-secrets
  namespace: yelp-lab2
type: Opaque
stringData:
  SECRET_KEY: "your-random-secret-key-here"
  YELP_API_KEY: "your-yelp-api-key-here"
  GROQ_API_KEY: "your-groq-api-key-here"
  TAVILY_API_KEY: "your-tavily-api-key-here"
